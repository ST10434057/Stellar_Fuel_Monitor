# Copy this file to local.properties and fill in your real values.
# Do NOT commit local.properties or release keystores.

# Hosted API base URL. Must end in /api/
# Physical-device LAN example: http://192.168.1.50:3000/api/
# Hosted production example: https://your-stellar-api.example.com/api/
STELLAR_API_BASE_URL=http://10.0.2.2:3000/api/

# Firebase Android application values from Firebase Console > Project settings > Your apps.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=

# OAuth 2.0 Web client ID used by Google Identity/Firebase Authentication.
GOOGLE_WEB_CLIENT_ID=

# Store listing/privacy policy URL shown in release documentation.
PLAY_STORE_PRIVACY_URL=https://example.com/privacy

# Release signing (required for a signed production APK/AAB).
# Path is resolved from android-app/. Keep the keystore outside source control where possible.
RELEASE_KEYSTORE_PATH=release/stellar-final-poe.jks
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=stellar-final-poe
RELEASE_KEY_PASSWORD=
