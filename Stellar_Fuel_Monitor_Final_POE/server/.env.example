PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=stellar_fuel_monitoring
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRESIN=8h
AUTH_REQUIRED=false
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
API_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_15_MIN=20
TRUST_PROXY=0
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_ORIGIN=Stellar Transport, Johannesburg, South Africa
GOOGLE_ROUTES_CACHE_DAYS=30

# Final POE — Firebase Cloud Messaging server credentials.
# Supply ONE private server-host secret: raw JSON OR Base64 (not both).
# Base64 is encoding, not encryption. Do not commit credentials to Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=prog7314-poe-giggle-gang

# Final POE — Azure Blob Storage.
# Recommended: create a private assessment container and provide a container SAS URL with read, add, create,
# write, delete and list (sp=racwdl) - the API also downloads (GET /api/evidence/:id/file) and deletes evidence.
# Example shape: https://ACCOUNT.blob.core.windows.net/CONTAINER?sv=...&sp=...&sig=...
AZURE_BLOB_CONTAINER_SAS_URL=
AZURE_BLOB_CONTAINER_NAME=stellar-evidence
# Keep true for local QA only. For the assessed cloud deployment set to false so misconfiguration is obvious.
BLOB_ALLOW_LOCAL_FALLBACK=true
# Rate limits for the quota-costing endpoints (per client IP).
EVIDENCE_UPLOADS_PER_15_MIN=30
PUSH_TRIGGERS_PER_15_MIN=20
